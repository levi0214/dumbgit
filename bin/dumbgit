#!/usr/bin/env bun
import { spawn, spawnSync } from 'node:child_process'
import {
  closeSync,
  mkdirSync,
  openSync,
  realpathSync,
} from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const PORT = 7777
const BASE_URL = `http://127.0.0.1:${PORT}`
const HEALTH_URL = `${BASE_URL}/healthz`

const scriptPath = realpathSync(fileURLToPath(import.meta.url))
const appRoot = path.resolve(path.dirname(scriptPath), '..')
const logPath = path.join(os.homedir(), 'Library', 'Logs', 'dumbgit.log')

function usage() {
  console.log(`usage: dumbgit [repo-path]
       dumbgit --stop

Open dumbgit for the current Git repo, or for repo-path when provided.
Stop the background server with --stop.`)
  process.exit(0)
}

function expandUser(p) {
  if (p === '~') return os.homedir()
  if (p.startsWith('~/')) return path.join(os.homedir(), p.slice(2))
  return p
}

function repoRoot(raw) {
  const dir = path.resolve(expandUser(raw))
  const r = spawnSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], {
    encoding: 'utf8',
  })
  if (r.status !== 0) {
    const msg = String(r.stderr ?? '').trim() || `not a git repo: ${dir}`
    console.error(`dumbgit: ${msg}`)
    process.exit(1)
  }
  return r.stdout.trim()
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

async function ping() {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 500)
  try {
    const r = await fetch(HEALTH_URL, { signal: controller.signal })
    const text = await r.text()
    return r.ok && text.trim() === 'ok' ? 'up' : 'occupied'
  } catch {
    return 'down'
  } finally {
    clearTimeout(timer)
  }
}

function startServer(repo) {
  mkdirSync(path.dirname(logPath), { recursive: true })
  const log = openSync(logPath, 'a')
  const child = spawn(process.execPath, ['run', 'src/index.tsx', repo], {
    cwd: appRoot,
    detached: true,
    stdio: ['ignore', log, log],
  })
  child.unref()
  closeSync(log)
}

function listeningPids() {
  const r = spawnSync('lsof', ['-ti', `tcp:${PORT}`, '-sTCP:LISTEN'], {
    encoding: 'utf8',
  })
  return [...new Set(r.stdout.split(/\s+/).filter(Boolean))]
}

async function stopServer() {
  const state = await ping()
  if (state === 'down') {
    console.log('dumbgit: not running')
    return
  }
  if (state === 'occupied') {
    console.error(`dumbgit: port ${PORT} is in use, but it is not dumbgit`)
    process.exit(1)
  }

  const pids = listeningPids()
  if (pids.length === 0) {
    console.error(`dumbgit: no listener found on port ${PORT}`)
    process.exit(1)
  }

  for (const pid of pids) {
    try {
      process.kill(Number(pid), 'SIGTERM')
    } catch {}
  }
  for (let i = 0; i < 20; i++) {
    if ((await ping()) === 'down') {
      console.log('dumbgit: stopped')
      return
    }
    await sleep(100)
  }

  for (const pid of pids) {
    try {
      process.kill(Number(pid), 'SIGKILL')
    } catch {}
  }
  console.log('dumbgit: stopped')
}

async function waitForServer() {
  for (let i = 0; i < 50; i++) {
    const state = await ping()
    if (state === 'up') return
    if (state === 'occupied') {
      console.error(`dumbgit: port ${PORT} is in use by another service`)
      process.exit(1)
    }
    await sleep(100)
  }
  console.error(`dumbgit: server did not start; see ${logPath}`)
  process.exit(1)
}

async function switchRepo(repo) {
  const url = `${BASE_URL}/api/repo?path=${encodeURIComponent(repo)}`
  const r = await fetch(url, { method: 'POST' })
  if (!r.ok) {
    console.error(`dumbgit: failed to open repo: ${repo}`)
    process.exit(1)
  }
}

function openBrowser() {
  const r = spawnSync('open', [BASE_URL], {
    stdio: 'ignore',
  })
  if (r.status !== 0) console.log(`dumbgit: open ${BASE_URL}`)
}

const args = process.argv.slice(2)
if (args.includes('-h') || args.includes('--help')) usage()
if (args.includes('--stop')) {
  if (args.length !== 1) usage()
  await stopServer()
  process.exit(0)
}
if (args.length > 1) usage()

const repo = repoRoot(args[0] ?? process.cwd())
const state = await ping()

if (state === 'occupied') {
  console.error(`dumbgit: port ${PORT} is in use by another service`)
  process.exit(1)
}

if (state === 'down') {
  startServer(repo)
  await waitForServer()
}

await switchRepo(repo)
openBrowser()
console.log(`dumbgit: ${repo}`)
