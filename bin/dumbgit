#!/usr/bin/env bun
import { spawn, spawnSync } from 'node:child_process'
import {
  closeSync,
  mkdirSync,
  openSync,
  realpathSync,
} from 'node:fs'
import net from 'node:net'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { rememberRepo } from '../src/history'

const LISTEN_HOST = '127.0.0.1'
const PORT_LO = 7777
const PORT_HI = 7900

const scriptPath = realpathSync(fileURLToPath(import.meta.url))
const appRoot = path.resolve(path.dirname(scriptPath), '..')
const logPath = path.join(os.homedir(), 'Library', 'Logs', 'dumbgit.log')

function usage(code = 0) {
  const text = `usage: dumbgit [dir]
       dumbgit workspace
       dumbgit list
       dumbgit stop [id|dir]
       dumbgit stop --all
       dumbgit restart`
  if (code === 0) console.log(text)
  else console.error(text)
  process.exit(code)
}

function die(msg) {
  console.error(`dumbgit: ${msg}`)
  usage(2)
}

function expandUser(p) {
  if (p === '~') return os.homedir()
  if (p.startsWith('~/')) return path.join(os.homedir(), p.slice(2))
  return p
}

function tryRepoRoot(raw) {
  const dir = path.resolve(expandUser(raw))
  const r = spawnSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], {
    encoding: 'utf8',
  })
  if (r.status !== 0) {
    return {
      ok: false,
      error: String(r.stderr ?? '').trim() || `not a git repo: ${dir}`,
    }
  }
  return { ok: true, repo: realpathSync(r.stdout.trim()) }
}

function repoRoot(raw) {
  const result = tryRepoRoot(raw)
  if (result.ok) return result.repo
  console.error(`dumbgit: ${result.error}`)
  process.exit(1)
}

function sameRepo(a, b) {
  try {
    return realpathSync(a) === realpathSync(b)
  } catch {
    return false
  }
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

/** True if TCP bind succeeds (port not in use locally). */
function portLooksFree(port) {
  return new Promise((resolve) => {
    const s = net.createServer()
    s.once('error', () => resolve(false))
    s.listen(port, LISTEN_HOST, () => {
      s.close(() => resolve(true))
    })
  })
}

async function allocatePort() {
  for (let p = PORT_LO; p <= PORT_HI; p++) {
    if (await portLooksFree(p)) return p
  }
  return undefined
}

async function fetchInstance(port) {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 450)
  try {
    const r = await fetch(`http://${LISTEN_HOST}:${port}/healthz.json`, {
      signal: controller.signal,
    })
    if (!r.ok) return null
    const j = await r.json()
    if (!j || j.ok !== true || j.name !== 'dumbgit') return null
    if (
      typeof j.pid !== 'number' ||
      typeof j.port !== 'number'
    ) {
      return null
    }
    if (j.port !== port) return null
    if (j.kind === 'workspace') {
      return {
        kind: 'workspace',
        pid: j.pid,
        port: j.port,
        url: `http://${LISTEN_HOST}:${port}`,
      }
    }
    if (typeof j.repo !== 'string') return null
    let repoAbs
    try {
      repoAbs = realpathSync(j.repo)
    } catch {
      return null
    }
    return {
      kind: 'repo',
      repo: repoAbs,
      pid: j.pid,
      port: j.port,
      url: `http://${LISTEN_HOST}:${port}`,
    }
  } catch {
    return null
  } finally {
    clearTimeout(timer)
  }
}

async function scanInstances() {
  const out = []
  for (let p = PORT_LO; p <= PORT_HI; p++) {
    const inst = await fetchInstance(p)
    if (inst) out.push(inst)
  }
  return out
}

function listeningPidsOnPort(port) {
  const r = spawnSync('lsof', ['-ti', `tcp:${port}`, '-sTCP:LISTEN'], {
    encoding: 'utf8',
  })
  return [...new Set(r.stdout.split(/\s+/).filter(Boolean))]
}

async function stopPorts(ports) {
  const seen = new Set()
  let stopped = false
  for (const port of ports) {
    const inst = await fetchInstance(port)
    if (!inst) continue
    const pids = listeningPidsOnPort(port)
    for (const pid of pids) {
      if (seen.has(pid)) continue
      seen.add(pid)
      stopped = true
      try {
        process.kill(Number(pid), 'SIGTERM')
      } catch {
        /* ignore */
      }
    }
  }

  await sleep(200)

  seen.clear()
  for (const port of ports) {
    const inst = await fetchInstance(port)
    if (!inst) continue
    const pids = listeningPidsOnPort(port)
    for (const pid of pids) {
      if (seen.has(pid)) continue
      seen.add(pid)
      try {
        process.kill(Number(pid), 'SIGKILL')
      } catch {
        /* ignore */
      }
    }
  }

  return stopped
}

async function portsMatching(pred) {
  const ports = []
  for (let p = PORT_LO; p <= PORT_HI; p++) {
    const inst = await fetchInstance(p)
    if (!inst) continue
    if (pred(inst)) ports.push(p)
  }
  return ports
}

async function cmdStopAll() {
  const ports = await portsMatching(() => true)
  if (ports.length === 0) {
    console.log('dumbgit: no dumbgit listeners running')
    return
  }
  const stopped = await stopPorts(ports)
  if (!stopped) {
    console.error('dumbgit: found listeners, but no process was stopped')
    process.exit(1)
  }
  console.log('dumbgit: stopped all listeners')
}

async function cmdStop(repoAbs) {
  const ports = await portsMatching(
    (inst) => inst.kind === 'repo' && sameRepo(inst.repo, repoAbs),
  )
  if (ports.length === 0) {
    console.log(`dumbgit: no dumbgit running for ${repoAbs}`)
    return
  }
  const stopped = await stopPorts(ports)
  if (!stopped) {
    console.error(`dumbgit: found ${repoAbs}, but no process was stopped`)
    process.exit(1)
  }
  console.log(`dumbgit: stopped ${repoAbs}`)
}

async function cmdStopId(rawId) {
  const id = Number(rawId)
  if (!Number.isSafeInteger(id) || id < 1) {
    console.error(`dumbgit: invalid instance id: ${rawId}`)
    process.exit(1)
  }

  const inst = await scanInstances()
  const hit = inst[id - 1]
  if (!hit) {
    console.error(`dumbgit: no dumbgit instance with id ${id}`)
    process.exit(1)
  }

  const stopped = await stopPorts([hit.port])
  const label = hit.kind === 'workspace' ? 'workspace' : hit.repo
  if (!stopped) {
    console.error(`dumbgit: found ${label}, but no process was stopped`)
    process.exit(1)
  }
  console.log(`dumbgit: stopped ${label}`)
}

async function cmdList() {
  const inst = await scanInstances()
  if (inst.length === 0) {
    console.log('dumbgit: no instances running')
    return
  }
  for (const [index, i] of inst.entries()) {
    const label = i.kind === 'workspace' ? '[workspace]' : i.repo
    console.log(`${index + 1}\t${label}\t${i.url}`)
  }
}

/** Wait until nothing is listening on `port` (post-stop). */
async function waitPortFree(port, msTotal = 5000) {
  const deadline = Date.now() + msTotal
  while (Date.now() < deadline) {
    if (await portLooksFree(port)) return true
    await sleep(50)
  }
  return false
}

/**
 * Stop every running instance and start each again on the same port.
 * Reloads server code after `bun link` / source edits without reshuffling ports.
 */
async function cmdRestart() {
  const inst = await scanInstances()
  if (inst.length === 0) {
    console.log('dumbgit: no instances running')
    return
  }

  const targets = inst.map((i) => ({
    kind: i.kind,
    repo: i.kind === 'repo' ? i.repo : undefined,
    port: i.port,
    url: i.url,
  }))
  const stopped = await stopPorts(targets.map((t) => t.port))
  if (!stopped) {
    console.error('dumbgit: found listeners, but no process was stopped')
    process.exit(1)
  }

  for (const t of targets) {
    if (!(await waitPortFree(t.port))) {
      console.error(
        `dumbgit: port ${t.port} still busy after stop (${t.repo ?? 'workspace'})`,
      )
      process.exit(1)
    }
    startServer(t.repo, t.port, t.kind === 'workspace')
    const ok = await waitForHealthy(t.port)
    if (!ok) {
      console.error(
        `dumbgit: failed to restart ${t.repo ?? 'workspace'}; see ${logPath}`,
      )
      process.exit(1)
    }
    console.log(`${t.repo ?? '[workspace]'}\t${t.url}`)
  }
  console.log(`dumbgit: restarted ${targets.length}`)
}

function startServer(repo, port, workspace = false) {
  mkdirSync(path.dirname(logPath), { recursive: true })
  const log = openSync(logPath, 'a')
  const args = ['run', 'src/index.tsx', '--port', String(port)]
  if (workspace) args.push('--workspace')
  else args.push(repo)
  const child = spawn(
    process.execPath,
    args,
    {
      cwd: appRoot,
      detached: true,
      stdio: ['ignore', log, log],
    },
  )
  child.unref()
  closeSync(log)
}

async function waitForHealthy(port, msTotal = 10000) {
  const deadline = Date.now() + msTotal
  while (Date.now() < deadline) {
    const inst = await fetchInstance(port)
    if (inst) return true
    await sleep(100)
  }
  return false
}

function openBrowserAt(port, pathname = '') {
  const url = `http://${LISTEN_HOST}:${port}${pathname}`
  const r = spawnSync('open', [url], {
    stdio: 'ignore',
  })
  if (r.status !== 0) console.log(`dumbgit: open ${url}`)
}

async function cmdStart(rawDir, open = true) {
  const repo = repoRoot(rawDir)
  rememberRepo(repo)
  const existing = await scanInstances()
  const hit = existing.find(
    (i) => i.kind === 'repo' && sameRepo(i.repo, repo),
  )
  if (hit) {
    if (open) openBrowserAt(hit.port)
    console.log(`dumbgit: ${repo}`)
    console.log(hit.url)
    return
  }

  const port = await allocatePort()
  if (port === undefined) {
    console.error(`dumbgit: no free TCP port ${PORT_LO}-${PORT_HI}`)
    process.exit(1)
  }

  startServer(repo, port)
  const ok = await waitForHealthy(port)
  if (!ok) {
    console.error(`dumbgit: server did not start; see ${logPath}`)
    process.exit(1)
  }

  if (open) openBrowserAt(port)
  const url = `http://${LISTEN_HOST}:${port}`
  console.log(`dumbgit: ${repo}`)
  console.log(url)
}

async function cmdWorkspace(open = true) {
  const existing = await scanInstances()
  const hit = existing.find((instance) => instance.kind === 'workspace')
  if (hit) {
    if (open) openBrowserAt(hit.port, '/workspace')
    console.log('dumbgit: workspace')
    console.log(`${hit.url}/workspace`)
    return
  }

  const port = await allocatePort()
  if (port === undefined) {
    console.error(`dumbgit: no free TCP port ${PORT_LO}-${PORT_HI}`)
    process.exit(1)
  }

  startServer(undefined, port, true)
  const ok = await waitForHealthy(port)
  if (!ok) {
    console.error(`dumbgit: workspace did not start; see ${logPath}`)
    process.exit(1)
  }
  if (open) openBrowserAt(port, '/workspace')
  const url = `http://${LISTEN_HOST}:${port}/workspace`
  console.log('dumbgit: workspace')
  console.log(url)
}

const rawArgv = process.argv.slice(2)
const noOpen = rawArgv.includes('--no-open')
const argv = rawArgv.filter((arg) => arg !== '--no-open')

if (argv.length === 1 && (argv[0] === '-h' || argv[0] === '--help')) {
  usage(0)
}

if (argv.length >= 1 && argv[0] === 'workspace') {
  if (argv.length !== 1) die('too many arguments')
  await cmdWorkspace(!noOpen)
  process.exit(0)
}

if (argv.length >= 1 && argv[0] === 'list') {
  if (argv.length !== 1) die('too many arguments')
  await cmdList()
  process.exit(0)
}

if (argv.length >= 1 && argv[0] === 'restart') {
  if (argv.length !== 1) die('too many arguments')
  await cmdRestart()
  process.exit(0)
}

if (argv.length >= 1 && argv[0] === 'stop') {
  const rest = argv.slice(1)
  if (rest.length === 0) {
    await cmdStop(repoRoot(process.cwd()))
    process.exit(0)
  }
  if (rest.length === 1 && rest[0] === '--all') {
    await cmdStopAll()
    process.exit(0)
  }
  if (rest.length === 1 && /^\d+$/.test(rest[0])) {
    await cmdStopId(rest[0])
    process.exit(0)
  }
  if (rest.length === 1 && !rest[0].startsWith('-')) {
    await cmdStop(repoRoot(rest[0]))
    process.exit(0)
  }
  die('invalid stop usage')
}

for (const a of argv) {
  if (a.startsWith('-')) die(`unknown option: ${a}`)
}
if (argv.length > 1) die('too many arguments')

if (argv[0]) {
  await cmdStart(argv[0], !noOpen)
} else {
  const cwdRepo = tryRepoRoot(process.cwd())
  if (cwdRepo.ok) await cmdStart(cwdRepo.repo, !noOpen)
  else await cmdWorkspace(!noOpen)
}
