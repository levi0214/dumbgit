#!/usr/bin/env bun
import { spawn, spawnSync } from 'node:child_process'
import {
  closeSync,
  mkdirSync,
  openSync,
  realpathSync,
} from 'node:fs'
import net from 'node:net'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const LISTEN_HOST = '127.0.0.1'
const PORT_LO = 7777
const PORT_HI = 7900

const scriptPath = realpathSync(fileURLToPath(import.meta.url))
const appRoot = path.resolve(path.dirname(scriptPath), '..')
const logPath = path.join(os.homedir(), 'Library', 'Logs', 'dumbgit.log')

function usage(code = 0) {
  const text = `usage: dumbgit [dir]
       dumbgit list
       dumbgit stop [dir]
       dumbgit stop --all`
  if (code === 0) console.log(text)
  else console.error(text)
  process.exit(code)
}

function die(msg) {
  console.error(`dumbgit: ${msg}`)
  usage(2)
}

function expandUser(p) {
  if (p === '~') return os.homedir()
  if (p.startsWith('~/')) return path.join(os.homedir(), p.slice(2))
  return p
}

function repoRoot(raw) {
  const dir = path.resolve(expandUser(raw))
  const r = spawnSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], {
    encoding: 'utf8',
  })
  if (r.status !== 0) {
    const msg = String(r.stderr ?? '').trim() || `not a git repo: ${dir}`
    console.error(`dumbgit: ${msg}`)
    process.exit(1)
  }
  return realpathSync(r.stdout.trim())
}

function sameRepo(a, b) {
  try {
    return realpathSync(a) === realpathSync(b)
  } catch {
    return false
  }
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

/** True if TCP bind succeeds (port not in use locally). */
function portLooksFree(port) {
  return new Promise((resolve) => {
    const s = net.createServer()
    s.once('error', () => resolve(false))
    s.listen(port, LISTEN_HOST, () => {
      s.close(() => resolve(true))
    })
  })
}

async function allocatePort() {
  for (let p = PORT_LO; p <= PORT_HI; p++) {
    if (await portLooksFree(p)) return p
  }
  return undefined
}

async function fetchInstance(port) {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 450)
  try {
    const r = await fetch(`http://${LISTEN_HOST}:${port}/healthz.json`, {
      signal: controller.signal,
    })
    if (!r.ok) return null
    const j = await r.json()
    if (!j || j.ok !== true || j.name !== 'dumbgit') return null
    if (
      typeof j.repo !== 'string' ||
      typeof j.pid !== 'number' ||
      typeof j.port !== 'number'
    ) {
      return null
    }
    if (j.port !== port) return null
    let repoAbs
    try {
      repoAbs = realpathSync(j.repo)
    } catch {
      return null
    }
    return {
      repo: repoAbs,
      pid: j.pid,
      port: j.port,
      url: `http://${LISTEN_HOST}:${port}`,
    }
  } catch {
    return null
  } finally {
    clearTimeout(timer)
  }
}

async function scanInstances() {
  const out = []
  for (let p = PORT_LO; p <= PORT_HI; p++) {
    const inst = await fetchInstance(p)
    if (inst) out.push(inst)
  }
  return out
}

function listeningPidsOnPort(port) {
  const r = spawnSync('lsof', ['-ti', `tcp:${port}`, '-sTCP:LISTEN'], {
    encoding: 'utf8',
  })
  return [...new Set(r.stdout.split(/\s+/).filter(Boolean))]
}

async function stopPorts(ports) {
  const seen = new Set()
  let stopped = false
  for (const port of ports) {
    const inst = await fetchInstance(port)
    if (!inst) continue
    const pids = listeningPidsOnPort(port)
    for (const pid of pids) {
      if (seen.has(pid)) continue
      seen.add(pid)
      stopped = true
      try {
        process.kill(Number(pid), 'SIGTERM')
      } catch {
        /* ignore */
      }
    }
  }

  await sleep(200)

  seen.clear()
  for (const port of ports) {
    const inst = await fetchInstance(port)
    if (!inst) continue
    const pids = listeningPidsOnPort(port)
    for (const pid of pids) {
      if (seen.has(pid)) continue
      seen.add(pid)
      try {
        process.kill(Number(pid), 'SIGKILL')
      } catch {
        /* ignore */
      }
    }
  }

  return stopped
}

async function portsMatching(pred) {
  const ports = []
  for (let p = PORT_LO; p <= PORT_HI; p++) {
    const inst = await fetchInstance(p)
    if (!inst) continue
    if (pred(inst)) ports.push(p)
  }
  return ports
}

async function cmdStopAll() {
  const ports = await portsMatching(() => true)
  if (ports.length === 0) {
    console.log('dumbgit: no dumbgit listeners running')
    return
  }
  const stopped = await stopPorts(ports)
  if (!stopped) {
    console.error('dumbgit: found listeners, but no process was stopped')
    process.exit(1)
  }
  console.log('dumbgit: stopped all listeners')
}

async function cmdStop(repoAbs) {
  const ports = await portsMatching((inst) => sameRepo(inst.repo, repoAbs))
  if (ports.length === 0) {
    console.log(`dumbgit: no dumbgit running for ${repoAbs}`)
    return
  }
  const stopped = await stopPorts(ports)
  if (!stopped) {
    console.error(`dumbgit: found ${repoAbs}, but no process was stopped`)
    process.exit(1)
  }
  console.log(`dumbgit: stopped ${repoAbs}`)
}

async function cmdList() {
  const inst = await scanInstances()
  if (inst.length === 0) {
    console.log('dumbgit: no instances running')
    return
  }
  for (const i of inst) {
    console.log(`${i.repo}\t${i.url}`)
  }
}

function startServer(repo, port) {
  mkdirSync(path.dirname(logPath), { recursive: true })
  const log = openSync(logPath, 'a')
  const child = spawn(
    process.execPath,
    ['run', 'src/index.tsx', '--port', String(port), repo],
    {
      cwd: appRoot,
      detached: true,
      stdio: ['ignore', log, log],
    },
  )
  child.unref()
  closeSync(log)
}

async function waitForHealthy(port, msTotal = 10000) {
  const deadline = Date.now() + msTotal
  while (Date.now() < deadline) {
    const inst = await fetchInstance(port)
    if (inst) return true
    await sleep(100)
  }
  return false
}

function openBrowserAt(port) {
  const url = `http://${LISTEN_HOST}:${port}`
  const r = spawnSync('open', [url], {
    stdio: 'ignore',
  })
  if (r.status !== 0) console.log(`dumbgit: open ${url}`)
}

async function cmdStart(rawDir) {
  const repo = repoRoot(rawDir)
  const existing = await scanInstances()
  const hit = existing.find((i) => sameRepo(i.repo, repo))
  if (hit) {
    openBrowserAt(hit.port)
    console.log(`dumbgit: ${repo}`)
    console.log(hit.url)
    return
  }

  const port = await allocatePort()
  if (port === undefined) {
    console.error(`dumbgit: no free TCP port ${PORT_LO}-${PORT_HI}`)
    process.exit(1)
  }

  startServer(repo, port)
  const ok = await waitForHealthy(port)
  if (!ok) {
    console.error(`dumbgit: server did not start; see ${logPath}`)
    process.exit(1)
  }

  openBrowserAt(port)
  const url = `http://${LISTEN_HOST}:${port}`
  console.log(`dumbgit: ${repo}`)
  console.log(url)
}

const argv = process.argv.slice(2)

if (argv.length === 1 && (argv[0] === '-h' || argv[0] === '--help')) {
  usage(0)
}

if (argv.length >= 1 && argv[0] === 'list') {
  if (argv.length !== 1) die('too many arguments')
  await cmdList()
  process.exit(0)
}

if (argv.length >= 1 && argv[0] === 'stop') {
  const rest = argv.slice(1)
  if (rest.length === 0) {
    await cmdStop(repoRoot(process.cwd()))
    process.exit(0)
  }
  if (rest.length === 1 && rest[0] === '--all') {
    await cmdStopAll()
    process.exit(0)
  }
  if (rest.length === 1 && !rest[0].startsWith('-')) {
    await cmdStop(repoRoot(rest[0]))
    process.exit(0)
  }
  die('invalid stop usage')
}

for (const a of argv) {
  if (a.startsWith('-')) die(`unknown option: ${a}`)
}
if (argv.length > 1) die('too many arguments')

await cmdStart(argv[0] ?? process.cwd())
