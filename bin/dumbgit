#!/usr/bin/env bun
import { spawn, spawnSync } from 'node:child_process'
import { closeSync, mkdirSync, openSync, realpathSync } from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import {
  readRepoHistory,
  rememberRepo,
  setRepoActive,
} from '../src/history'

const LISTEN_HOST = '127.0.0.1'
const PORT = 7777
const scriptPath = realpathSync(fileURLToPath(import.meta.url))
const appRoot = path.resolve(path.dirname(scriptPath), '..')
const logPath = path.join(os.homedir(), 'Library', 'Logs', 'dumbgit.log')

function usage(code = 0) {
  const text = `usage: dumbgit [dir]
       dumbgit workspace
       dumbgit start [dir]
       dumbgit list
       dumbgit stop [id|dir]
       dumbgit stop --all
       dumbgit restart`
  if (code === 0) console.log(text)
  else console.error(text)
  process.exit(code)
}

function die(message) {
  console.error(`dumbgit: ${message}`)
  usage(2)
}

function expandUser(value) {
  if (value === '~') return os.homedir()
  if (value.startsWith('~/')) return path.join(os.homedir(), value.slice(2))
  return value
}

function tryRepoRoot(raw) {
  const dir = path.resolve(expandUser(raw))
  const result = spawnSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], {
    encoding: 'utf8',
  })
  if (result.status !== 0) {
    return {
      ok: false,
      error: String(result.stderr ?? '').trim() || `not a git repo: ${dir}`,
    }
  }
  return { ok: true, repo: realpathSync(result.stdout.trim()) }
}

function repoRoot(raw) {
  const result = tryRepoRoot(raw)
  if (result.ok) return result.repo
  console.error(`dumbgit: ${result.error}`)
  process.exit(1)
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

async function fetchController() {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 500)
  try {
    const response = await fetch(
      `http://${LISTEN_HOST}:${PORT}/healthz.json`,
      { signal: controller.signal },
    )
    if (!response.ok) return null
    const data = await response.json()
    if (
      data?.ok !== true ||
      data?.name !== 'dumbgit' ||
      data?.kind !== 'workspace' ||
      data?.port !== PORT ||
      typeof data?.pid !== 'number'
    ) {
      return null
    }
    return {
      kind: data.kind,
      pid: data.pid,
      port: PORT,
      url: `http://${LISTEN_HOST}:${PORT}`,
    }
  } catch {
    return null
  } finally {
    clearTimeout(timer)
  }
}

function listeningPids() {
  const result = spawnSync('lsof', ['-ti', `tcp:${PORT}`, '-sTCP:LISTEN'], {
    encoding: 'utf8',
  })
  return [...new Set(result.stdout.split(/\s+/).filter(Boolean))]
}

async function stopController() {
  const instance = await fetchController()
  if (!instance) return false
  for (const pid of listeningPids()) {
    try {
      process.kill(Number(pid), 'SIGTERM')
    } catch {
      // The process may already have exited.
    }
  }
  const deadline = Date.now() + 5000
  while (Date.now() < deadline) {
    if (!(await fetchController())) return true
    await sleep(50)
  }
  return false
}

function startController() {
  mkdirSync(path.dirname(logPath), { recursive: true })
  const log = openSync(logPath, 'a')
  const child = spawn(
    process.execPath,
    ['run', 'src/index.tsx', '--port', String(PORT), '--workspace'],
    {
      cwd: appRoot,
      detached: true,
      stdio: ['ignore', log, log],
    },
  )
  child.unref()
  closeSync(log)
}

async function waitForController(msTotal = 10000) {
  const deadline = Date.now() + msTotal
  while (Date.now() < deadline) {
    const instance = await fetchController()
    if (instance) return instance
    await sleep(100)
  }
  return null
}

function openBrowser(pathname = '/') {
  const url = `http://${LISTEN_HOST}:${PORT}${pathname}`
  const result = spawnSync('open', [url], { stdio: 'ignore' })
  if (result.status !== 0) console.log(`dumbgit: open ${url}`)
}

async function ensureWorkspace(open = true, focusRepo) {
  let instance = await fetchController()
  if (!instance) {
    startController()
    instance = await waitForController()
  }
  if (!instance) {
    console.error(`dumbgit: workspace did not start on port ${PORT}; see ${logPath}`)
    process.exit(1)
  }
  const pathname = focusRepo
    ? `/?repo=${encodeURIComponent(focusRepo)}`
    : '/'
  if (open) openBrowser(pathname)
  console.log('dumbgit: workspace')
  console.log(`${instance.url}${pathname}`)
}

async function activateRepo(rawDir, open = true) {
  const repo = repoRoot(rawDir)
  rememberRepo(repo, true)
  await ensureWorkspace(open, repo)
}

function deactivateRepo(rawDir) {
  const repo = repoRoot(rawDir)
  if (!setRepoActive(repo, false)) {
    console.error(`dumbgit: repository is not in Workspace: ${repo}`)
    process.exit(1)
  }
  console.log(`dumbgit: stopped monitoring ${repo}`)
}

function deactivateRepoId(rawId) {
  const id = Number(rawId)
  const repos = readRepoHistory()
  const entry = Number.isSafeInteger(id) && id > 0 ? repos[id - 1] : undefined
  if (!entry || !setRepoActive(entry.repoPath, false)) {
    console.error(`dumbgit: no Workspace repository with id ${rawId}`)
    process.exit(1)
  }
  console.log(`dumbgit: stopped monitoring ${entry.repoPath}`)
}

async function cmdList() {
  const instance = await fetchController()
  console.log(
    instance
      ? `workspace\trunning\t${instance.url}`
      : 'workspace\tstopped',
  )
  for (const [index, entry] of readRepoHistory().entries()) {
    console.log(`${index + 1}\t${entry.active ? 'active' : 'inactive'}\t${entry.repoPath}`)
  }
}

async function cmdRestart(open = false) {
  await stopController()
  startController()
  const instance = await waitForController()
  if (!instance) {
    console.error(`dumbgit: workspace did not restart; see ${logPath}`)
    process.exit(1)
  }
  if (open) openBrowser('/')
  console.log(`dumbgit: restarted\t${instance.url}`)
}

const rawArgv = process.argv.slice(2)
const noOpen = rawArgv.includes('--no-open')
const argv = rawArgv.filter((arg) => arg !== '--no-open')

if (argv.length === 1 && (argv[0] === '-h' || argv[0] === '--help')) usage(0)

if (argv[0] === 'workspace') {
  if (argv.length !== 1) die('too many arguments')
  await ensureWorkspace(!noOpen)
  process.exit(0)
}

if (argv[0] === 'start') {
  if (argv.length > 2) die('too many arguments')
  await activateRepo(argv[1] ?? process.cwd(), !noOpen)
  process.exit(0)
}

if (argv[0] === 'list') {
  if (argv.length !== 1) die('too many arguments')
  await cmdList()
  process.exit(0)
}

if (argv[0] === 'restart') {
  if (argv.length !== 1) die('too many arguments')
  await cmdRestart(false)
  process.exit(0)
}

if (argv[0] === 'stop') {
  const rest = argv.slice(1)
  if (rest.length === 1 && rest[0] === '--all') {
    const stopped = await stopController()
    console.log(stopped ? 'dumbgit: stopped workspace' : 'dumbgit: workspace is not running')
    process.exit(0)
  }
  if (rest.length === 0) {
    deactivateRepo(process.cwd())
    process.exit(0)
  }
  if (rest.length === 1 && /^\d+$/.test(rest[0])) {
    deactivateRepoId(rest[0])
    process.exit(0)
  }
  if (rest.length === 1 && !rest[0].startsWith('-')) {
    deactivateRepo(rest[0])
    process.exit(0)
  }
  die('invalid stop usage')
}

for (const arg of argv) {
  if (arg.startsWith('-')) die(`unknown option: ${arg}`)
}
if (argv.length > 1) die('too many arguments')

if (argv[0]) {
  await activateRepo(argv[0], !noOpen)
} else {
  const cwdRepo = tryRepoRoot(process.cwd())
  if (cwdRepo.ok) await activateRepo(cwdRepo.repo, !noOpen)
  else await ensureWorkspace(!noOpen)
}
