{
  "name": "dumbgit",
  "private": true,
  "description": "A tiny Git GUI for one person on one Mac.",
  "license": "MIT",
  "author": "Luyao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levi0214/dumbgit.git"
  },
  "homepage": "https://github.com/levi0214/dumbgit",
  "bugs": {
    "url": "https://github.com/levi0214/dumbgit/issues"
  },
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "dg": "./bin/dg.js"
  },
  "scripts": {
    "dev": "bun --watch src/index.tsx --no-idle-exit",
    "start": "bun run src/index.tsx --open",
    "build": "bun build --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig bin/dg.js --outfile dist/dg",
    "test": "bun test"
  },
  "devDependencies": {
    "bun-types": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "hono": "^4.13.5"
  }
}
